local function ApexTeleport(targetCFrame)
    -- Si Auto Select está activo, revisar inventario ANTES de teletransportar
    if getgenv().AutoSelectEnabled then
        UpdateTeleportMethod()
    end

    -- Limpiar estado residual por si acaso
    if TeleportingInProgress then
        TeleportingInProgress = false
        NoclipDuringTeleport = false
        if not NoclipEnabled then
            NoclipEnabled = false
        end
    end
    
    local target
    if typeof(targetCFrame) == "CFrame" then
        target = targetCFrame
    elseif typeof(targetCFrame) == "Vector3" then
        target = CFrame.new(targetCFrame)
    else
        return false
    end

    return handleMovement(target.Position)
end

