local function isProtected(obj)
    if not obj then return false end
    if obj.Name == "Floor" then return true end
    local parent = obj.Parent
    while parent do
        if parent.Name == "Floor" then return true end
        parent = parent.Parent
    end
    return false
end

local function setRedTransparent(obj)
    if obj and obj:IsA("BasePart") then
        if isProtected(obj) then return end
        if not obj:GetAttribute("OriginalColor") then
            obj:SetAttribute("OriginalColor", obj.Color)
        end
        if not obj:GetAttribute("OriginalTransparency") then
            obj:SetAttribute("OriginalTransparency", obj.Transparency)
        end
        obj.Color = Color3.new(1, 0, 0)
        obj.Transparency = 0.5
    end
end

local function restoreObject(obj)
    if obj and obj:IsA("BasePart") then
        if isProtected(obj) then return end
        local originalColor = obj:GetAttribute("OriginalColor")
        local originalTransparency = obj:GetAttribute("OriginalTransparency")
        if originalColor then
            obj.Color = originalColor
        end
        if originalTransparency then
            obj.Transparency = originalTransparency
        end
        obj:SetAttribute("OriginalColor", nil)
        obj:SetAttribute("OriginalTransparency", nil)
    end
end

getgenv().DeletedObjects = getgenv().DeletedObjects or {}

local function deleteObject(obj)
    if obj and obj:IsA("BasePart") then
        if isProtected(obj) then return end
        if obj:IsDescendantOf(workspace) and not obj:IsDescendantOf(LocalPlayer.Character) then
            -- Guardar UNA COPIA LIMPIA del objeto (sin modificaciones de color/transparencia)
            local clone = obj:Clone()
            
            -- Guardar el objeto con sus propiedades ORIGINALES (no las modificadas)
            table.insert(getgenv().DeletedObjects, {
                Name = obj.Name,
                Parent = obj.Parent,
                -- Guardar propiedades ORIGINALES (las que tenía antes de ser modificado)
                Properties = {
                    Position = obj.Position,
                    CFrame = obj.CFrame,
                    Size = obj.Size,
                    -- USAR LAS PROPIEDADES GUARDADAS EN ATTRIBUTES (color y transparencia originales)
                    Color = obj:GetAttribute("OriginalColor") or obj.Color,
                    Transparency = obj:GetAttribute("OriginalTransparency") or obj.Transparency,
                    Material = obj.Material,
                    Anchored = obj.Anchored,
                    CanCollide = obj.CanCollide,
                },
                -- Guardar el clon SOLO para usarlo como template, pero luego lo destruimos
                Clone = clone
            })
            obj:Destroy()
        end
    end
end

function RestoreAllDeleted()
    local trash = getgenv().DeletedObjects
    if #trash == 0 then return false end
    
    for i = #trash, 1, -1 do
        local data = trash[i]
        if data and data.Clone then
            pcall(function()
                -- Crear un NUEVO objeto desde el clon
                local newObj = data.Clone:Clone()
                
                -- Aplicar las propiedades ORIGINALES (que ya están guardadas con color/transparencia original)
                for prop, value in pairs(data.Properties or {}) do
                    pcall(function()
                        newObj[prop] = value
                    end)
                end
                
                -- ELIMINAR CUALQUIER ATTRIBUTO que pueda tener (para que no se guarde nada)
                pcall(function()
                    newObj:SetAttribute("OriginalColor", nil)
                    newObj:SetAttribute("OriginalTransparency", nil)
                end)
                
                -- Restaurar al padre original
                if data.Parent and data.Parent:IsA("Instance") then
                    newObj.Parent = data.Parent
                else
                    newObj.Parent = workspace
                end
            end)
            
            -- Destruir el clon guardado
            pcall(function()
                if data.Clone then data.Clone:Destroy() end
            end)
        end
    end
    
    getgenv().DeletedObjects = {}
    return true
end

local clickDeleteMouse = LocalPlayer:GetMouse()

local function startClickDelete()
    -- Limpiar conexiones anteriores
    for _, conn in ipairs(ClickDelete.connections) do
        conn:Disconnect()
    end
    ClickDelete.connections = {}
    ClickDelete.currentHoveredObject = nil
    ClickDelete.keyPressed = false
    
    if not ClickDelete.Enabled then return end
    
    local currentKey = ClickDelete.DeleteKey
    
    -- DETECTAR CUANDO SE PRESIONA LA TECLA
    local inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == currentKey then
            ClickDelete.keyPressed = true
            local target = clickDeleteMouse.Target
            if target and not isProtected(target) then
                ClickDelete.currentHoveredObject = target
                setRedTransparent(target)
            end
        end
    end)
    table.insert(ClickDelete.connections, inputBeganConn)
    
    -- DETECTAR CUANDO SE SUELTA LA TECLA
    local inputEndedConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if input.KeyCode == currentKey then
            ClickDelete.keyPressed = false
            if ClickDelete.currentHoveredObject then
                restoreObject(ClickDelete.currentHoveredObject)
                ClickDelete.currentHoveredObject = nil
            end
        end
    end)
    table.insert(ClickDelete.connections, inputEndedConn)
    
    -- DETECTAR CLICK IZQUIERDO MIENTRAS LA TECLA ESTÁ PRESIONADA
    local clickConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 and ClickDelete.keyPressed then
            local target = clickDeleteMouse.Target
            if target and target:IsA("BasePart") and not target:IsDescendantOf(LocalPlayer.Character) then
                deleteObject(target)
                if ClickDelete.currentHoveredObject == target then
                    ClickDelete.currentHoveredObject = nil
                end
            end
        end
    end)
    table.insert(ClickDelete.connections, clickConn)
    
    -- ACTUALIZAR RESALTADO CUANDO EL MOUSE SE MUEVE
    local moveConn = clickDeleteMouse.Move:Connect(function()
        local target = clickDeleteMouse.Target
        if ClickDelete.keyPressed then
            if target ~= ClickDelete.currentHoveredObject then
                if ClickDelete.currentHoveredObject then
                    restoreObject(ClickDelete.currentHoveredObject)
                end
                if target and target:IsA("BasePart") and not target:IsDescendantOf(LocalPlayer.Character) then
                    if not isProtected(target) then
                        ClickDelete.currentHoveredObject = target
                        setRedTransparent(target)
                    else
                        ClickDelete.currentHoveredObject = nil
                    end
                else
                    ClickDelete.currentHoveredObject = nil
                end
            end
        else
            if ClickDelete.currentHoveredObject then
                restoreObject(ClickDelete.currentHoveredObject)
                ClickDelete.currentHoveredObject = nil
            end
        end
    end)
    table.insert(ClickDelete.connections, moveConn)
    
    -- LIMPIAR CUANDO EL PERSONAJE RESPAWNEA
    local charAddedConn = LocalPlayer.CharacterAdded:Connect(function()
        ClickDelete.keyPressed = false
        if ClickDelete.currentHoveredObject then
            restoreObject(ClickDelete.currentHoveredObject)
            ClickDelete.currentHoveredObject = nil
        end
    end)
    table.insert(ClickDelete.connections, charAddedConn)
end

local function stopClickDelete()
    for _, conn in ipairs(ClickDelete.connections) do
        conn:Disconnect()
    end
    ClickDelete.connections = {}
    if ClickDelete.currentHoveredObject then
        restoreObject(ClickDelete.currentHoveredObject)
        ClickDelete.currentHoveredObject = nil
    end
    ClickDelete.keyPressed = false
end

-- Funciones para controlar Click Delete desde la GUI
function setClickDelete(enabled)
    ClickDelete.Enabled = enabled
    if enabled then
        startClickDelete()
    else
        stopClickDelete()
    end
end

local function setDeleteKey(key)
    if key and key ~= "" then
        if type(key) == "string" then
            local keyName = key:gsub("Enum.KeyCode.", "")
            ClickDelete.DeleteKey = Enum.KeyCode[keyName] or Enum.KeyCode.LeftAlt
        else
            ClickDelete.DeleteKey = key
        end
        if ClickDelete.Enabled then
            stopClickDelete()
            startClickDelete()
        end
    end
end

