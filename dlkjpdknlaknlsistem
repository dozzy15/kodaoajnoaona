-- NUEVA FUNCIÓN: Noclip + AutoClimb integrado
local Noclip = function()
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- ============================================
    -- PARTE 1: DETECTAR PIERNAS PARA AUTOCLIMB
    -- ============================================
    local legParts = {}
    for _, partName in ipairs({"LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg",
                               "LeftFoot", "RightFoot"}) do
        local part = Character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            table.insert(legParts, part)
        end
    end
    
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {Character}
    overlapParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    -- Verificar si las piernas están tocando un objeto para subir
    local shouldClimb = false
    local climbTarget = nil
    local climbHeight = 0
    
    for _, legPart in ipairs(legParts) do
        if not legPart then continue end
        
        local nearbyParts = Workspace:GetPartsInPart(legPart, overlapParams)
        
        for _, part in ipairs(nearbyParts) do
            if not part:IsA("BasePart") then continue end
            if part:IsDescendantOf(Character) then continue end
            
            -- Verificar si es un objeto válido
            if ExclusionsSideWalk_Folder(part) then continue end
            if Workspace:FindFirstChild("Do not touch") then continue end
            
            -- Verificar distancia real
            local distance = (part.Position - legPart.Position).Magnitude
            if distance > 2.5 then continue end
            
            -- Calcular altura del objeto
            local objectHeight = part.Size.Y
            if objectHeight > 2.5 then continue end -- Objeto muy alto, no subir
            
            local topY = part.Position.Y + (part.Size.Y / 2)
            local currentY = Root.Position.Y
            local heightDiff = topY - currentY
            
            -- Solo subir si el objeto está a una altura razonable
            if heightDiff > 0.1 and heightDiff < 3.5 then
                shouldClimb = true
                climbTarget = part
                climbHeight = topY + 0.2 -- Posición encima del objeto
                break
            end
        end
        if shouldClimb then break end
    end
    
    -- ============================================
    -- PARTE 2: SUBIR AUTOMÁTICAMENTE (si es necesario)
    -- ============================================
    if shouldClimb and climbTarget and climbTarget.Parent then
        -- Subir gradualmente al objeto
        local startY = Root.Position.Y
        local endY = climbHeight
        
        -- Subida suave en pasos
        local steps = math.max(math.ceil((endY - startY) / 0.3), 3)
        
        for i = 1, steps do
            local t = i / steps
            local lerpY = startY + (endY - startY) * t
            Root.Position = Vector3.new(Root.Position.X, lerpY, Root.Position.Z)
            task.wait(0.03)
        end
        
        -- Posición final exacta
        Root.Position = Vector3.new(Root.Position.X, endY, Root.Position.Z)
        
        -- Después de subir, continuar con el noclip normal
    end
    
    -- ============================================
    -- PARTE 3: NOCLIP NORMAL (solo partes superiores)
    -- ============================================
    
    -- Obtener SOLO las partes SUPERIORES del cuerpo (excluyendo piernas y pies)
    local bodyParts = {}
    for _, partName in ipairs({"Head", "UpperTorso", "LowerTorso", 
                               "LeftUpperArm", "LeftLowerArm", 
                               "RightUpperArm", "RightLowerArm",
                               "HumanoidRootPart"}) do
        local part = Character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            table.insert(bodyParts, part)
        end
    end
    
    -- Para CADA parte del cuerpo SUPERIOR, verificar qué objeto toca
    for _, bodyPart in ipairs(bodyParts) do
        if not bodyPart or not bodyPart:IsA("BasePart") then continue end
        
        -- Detectar objetos que ESTÁ TOCANDO esta parte del cuerpo
        local nearbyParts = Workspace:GetPartsInPart(bodyPart, overlapParams)
        
        for _, part in ipairs(nearbyParts) do
            if not part:IsA("BasePart") then continue end
            if part == bodyPart then continue end
            if part:IsDescendantOf(Character) then continue end
            
            -- Verificar si está en la blacklist
            if ExclusionsSideWalk_Folder(part) then continue end
            if Workspace:FindFirstChild("Do not touch") then continue end
            
            -- Verificar distancia real
            local distance = (part.Position - bodyPart.Position).Magnitude
            if distance > 2.5 then continue end
            
            -- Si el objeto es el mismo que estamos subiendo, NO desactivar colisiones
            if part == climbTarget then continue end
            
            -- ¡DESACTIVAR COLISIONES SOLO DE ESTE OBJETO!
            if not NoclipParts[part] then
                NoclipParts[part] = { CanCollide = part.CanCollide }
                SetHiddenProperty(part, "CanCollide", false)
            end
        end
        
        -- Raycast para detectar objetos en la dirección del movimiento
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {Character}
        params.FilterType = Enum.RaycastFilterType.Blacklist
        
        local directions = {
            bodyPart.CFrame.LookVector,
            bodyPart.CFrame.LookVector * -1,
            bodyPart.CFrame.RightVector,
            bodyPart.CFrame.RightVector * -1,
            Vector3.new(0, -1, 0),
            Vector3.new(0, 1, 0),
        }
        
        local maxDistance = 2.5
        for _, dir in ipairs(directions) do
            local origin = bodyPart.Position
            local hit = Workspace:Raycast(origin, dir * maxDistance, params)
            if hit then
                local part = hit.Instance
                if part and part:IsA("BasePart") then
                    if not ExclusionsSideWalk_Folder(part) and not Workspace:FindFirstChild("Do not touch") then
                        if part ~= climbTarget then -- No desactivar el objeto que estamos subiendo
                            if not NoclipParts[part] then
                                NoclipParts[part] = { CanCollide = part.CanCollide }
                                SetHiddenProperty(part, "CanCollide", false)
                            end
                        end
                    end
                end
            end
        end
    end
end

