local InstantInteract = getgenv().InstantInteract

-- Función ultra rápida para completar interacciones
local function completeInteraction(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    
    -- Guardar configuración original
    local originalHoldDuration = prompt.HoldDuration
    local originalEnabled = prompt.Enabled
    local originalLOS = prompt.RequiresLineOfSight
    local originalMaxDist = prompt.MaxActivationDistance
    
    -- Configurar para interacción instantánea
    prompt.HoldDuration = 0
    prompt.Enabled = true
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 100
    
    -- Método 1: InputHold
    pcall(function()
        prompt:InputHoldBegin()
        task.wait() -- 1 frame (~16ms) pero necesario para que el servidor lo detecte
        prompt:InputHoldEnd()
    end)
    
    -- Método 2: FireProximityPrompt (backup)
    pcall(function()
        fireproximityprompt(prompt)
    end)
    
    -- Método 3: Replicar señal directamente
    pcall(function()
        if prompt.Triggered then
            prompt.Triggered:Fire()
        end
    end)
    
    -- Restaurar configuración original (si no está en 0)
    task.spawn(function()
        if originalHoldDuration ~= 0 then
            prompt.HoldDuration = originalHoldDuration
        end
        prompt.Enabled = originalEnabled
        prompt.RequiresLineOfSight = originalLOS
        prompt.MaxActivationDistance = originalMaxDist
    end)
end

