-- ========== AUTO-SELECT TELEPORT METHOD BASED ON INVENTORY ==========
local function ShouldUseInstantMethod()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if not character then
        return false
    end
    
    local function getAllTools(container)
        local tools = {}
        if not container then return tools end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(tools, child.Name)
            end
        end
        return tools
    end
    
    local characterTools = getAllTools(character)
    local backpackTools = getAllTools(backpack)
    
    local allTools = {}
    for _, name in ipairs(characterTools) do
        table.insert(allTools, name)
    end
    for _, name in ipairs(backpackTools) do
        table.insert(allTools, name)
    end
    
    if #allTools == 0 then
        return true   -- vacío → Instant
    end
    
    for _, toolName in ipairs(allTools) do
        if toolName ~= "Fist" and toolName ~= "Phone" then
            return false  -- tiene otro item → Tween
        end
    end
    
    return true  -- solo Fist/Phone → Instant
end

local function UpdateTeleportMethod()
    if ShouldUseInstantMethod() then
        RuntimeState.zzzMeth = "Instant"
    else
        RuntimeState.zzzMeth = "Tween"
    end
end

