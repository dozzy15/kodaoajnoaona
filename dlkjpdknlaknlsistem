local ExclusionsSideWalk_Folder = function(Part)
    local partName = Part.Name:lower()

    for _, entry in ipairs(NoclipBlacklist) do
        if typeof(entry) == "string" then
            if Part.Name == entry or partName == entry:lower() then
                return true
            end
        elseif typeof(entry) == "Vector3" then
            if Part:IsA("BasePart") and (Part.Position - entry).Magnitude < 1.5 then
                return true
            end
        end
    end

    -- Excluir la moto del jugador
    local bike = Workspace:FindFirstChild(LocalPlayer.Name .. "'s Car")
    if bike and Part:IsDescendantOf(bike) then
        return true
    end

    return (RoadSidewalkFolder and Part:IsDescendantOf(RoadSidewalkFolder))
        or (Part.Name == "default")
        or (Part.Name == "Sidewalk")
        or (Part.Name == "Floor")
        or (Part.Name == "Collision")
        or (Part.Name == "QuaterCylinder")
        or Part:IsDescendantOf(LocalPlayer.Character)
        or (Part.Parent and Part.Parent:IsA("Model") and Players:GetPlayerFromCharacter(Part.Parent) ~= nil)
        or (Part:IsA("VehicleSeat") or Part:IsA("Vehicle"))
        or (Part.Name == "AntiFall_Platform1")
        or (Part.Name == "AntiFall_Platform2")
        or (partName:find("undergroundbp"))
        or (partName:find("baseplate"))
        or (partName:find("platform"))
end

