-- ========== MOVEMENT (Apex Tween + Underground) ==========
local stepDistance = 1.5
local waitTime = 0.08

local function GetLiveCharacter(timeout)
    local deadline = os.clock() + (timeout or 0)
    repeat
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if Character and Character.Parent and Humanoid and Humanoid.Health > 0 and RootPart and RootPart.Parent then
            return Character, Humanoid, RootPart
        end
        if not timeout or timeout <= 0 then break end
        task.wait(0.05)
    until os.clock() >= deadline
    return nil, nil, nil
end

local function functionFirePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then 
        return false 
    end
    
    prompt.Enabled = true
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 100

    local success = pcall(function()
        fireproximityprompt(prompt)
    end)
    
    if not success then
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end
    
    return true
end

local function GetRootPart(timeout)
    local _, _, RootPart = GetLiveCharacter(timeout or 2)
    return RootPart
end

local function moveToPosition(character, targetPosition, customStep, customWait)
    local _, _, humanoidRootPart = GetLiveCharacter(3)
    if not humanoidRootPart then return false end

    local moveStep = customStep or stepDistance
    local moveWait = customWait or waitTime
    local distance = (targetPosition - humanoidRootPart.Position).Magnitude

    -- Ahora funciona SIEMPRE (no solo cuando hay farm activo)
    while distance > moveStep do
        _, _, humanoidRootPart = GetLiveCharacter(3)
        if not humanoidRootPart then return false end

        local currentPosition = humanoidRootPart.Position
        distance = (targetPosition - currentPosition).Magnitude
        if distance <= moveStep then break end

        local direction = (targetPosition - currentPosition).Unit
        humanoidRootPart.CFrame = CFrame.new(currentPosition + direction * moveStep)
        task.wait(moveWait)
    end

    _, _, humanoidRootPart = GetLiveCharacter(3)
    if humanoidRootPart then
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
    else
        return false
    end
    return true
end

local function handleMovement(dirP)
    local isTweenMode = (RuntimeState.zzzMeth ~= "Instant")
    
    -- Solo activar noclip TEMPORAL (no tocar el toggle de la GUI)
    if isTweenMode and not TeleportingInProgress then
        TeleportingInProgress = true
        NoclipDuringTeleport = true
    end
    
    if RuntimeState.zzzMeth == "Instant" then
        local RootPart = GetRootPart(6)
        if not RootPart then 
            TeleportingInProgress = false
            NoclipDuringTeleport = false
            return false 
        end

        RootPart.CFrame = CFrame.new(0, 9e9, 0)
        task.wait(1.8)

        RootPart = GetRootPart(6)
        if not RootPart then 
            TeleportingInProgress = false
            NoclipDuringTeleport = false
            return false 
        end

        RootPart.CFrame = CFrame.new(dirP)
        task.wait(0.35)
        
        TeleportingInProgress = false
        NoclipDuringTeleport = false
        return true

    else
        -- ========== MODO TWEEN ==========
        __swnBP()

        local Character, _, RootPart = GetLiveCharacter(3)
        if not Character or not RootPart then
            DeleteUndergroundBaseplates()
            TeleportingInProgress = false
            NoclipDuringTeleport = false
            return false
        end

        -- Agacharse (C)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
        end)
        task.wait(0.12)

        local undergroundStart = Vector3.new(RootPart.Position.X, -2.4, RootPart.Position.Z)
        RootPart.CFrame = CFrame.new(undergroundStart)
        task.wait(0.45)

        local undergroundTarget = Vector3.new(dirP.X, -2.8, dirP.Z)
        local success = moveToPosition(Character, undergroundTarget)

        if success then
            _, _, RootPart = GetLiveCharacter(3)
            if RootPart then
                RootPart.CFrame = CFrame.new(dirP)
                task.wait(0.4)
            end
        end

        -- Levantarse (soltar C)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
        end)
        task.wait(0.1)

        -- Borrar segundo piso
        DeleteUndergroundBaseplates()

        -- Apagar noclip temporal (NO tocar NoclipEnabled del toggle)
        TeleportingInProgress = false
        NoclipDuringTeleport = false

        return success
    end
end

local function PreMaskTeleport(dirP, useHighTp)
    if RuntimeState.zzzMeth == "Instant" or useHighTp then
        local RootPart = GetRootPart(6)
        if not RootPart then return false end

        RootPart.CFrame = CFrame.new(0, 9e9, 0)
